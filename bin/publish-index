#!/bin/bash

# Publishes a signed index.json as this repo's "index" release, where a box
# reads it (ADR-010, ADR-036). It runs in CI on main. Before it publishes,
# agentv-os's own installer installs each app from the signed index, from
# GitHub, with agentv-keyring's key, the way a box does.
#
# It never has the signing key. bin/index builds the index, bin/sign-index
# signs it in a job of its own, and this takes what that job hands on:
# <dir> has index.json, index.json.sig and agentv.gpg, the public key
# agentv-keyring puts on every box.
#
# Usage: bin/publish-index <dir>   (needs GITHUB_REPOSITORY, GITHUB_SHA and
#                                   GH_TOKEN, as CI has them)

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
dir=$(realpath "${1:?usage: bin/publish-index <dir>}")

if [[ -n ${AGENTV_SIGNING_KEY:-} ]]; then
  echo "::error::bin/publish-index doesn't sign, so don't give it AGENTV_SIGNING_KEY. bin/sign-index signs." >&2
  exit 1
fi
: "${GITHUB_REPOSITORY:?}" "${GITHUB_SHA:?}"
for file in index.json index.json.sig agentv.gpg; do
  [[ -s $dir/$file ]] || { echo "::error::$dir has no $file. The index is only ever published signed." >&2; exit 1; }
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Each app, as a box installs it. The installer checks the signature against
# agentv-keyring's key, so an index that isn't signed by it stops here.
"$ROOT/bin/fetch-agentv-os"
mkdir "$work/state"
for id in $(jq -r '.apps[].id' "$dir/index.json"); do
  AGENTV_PATH="$ROOT/.agentv-os" AGENTV_STATE="$work/state" AGENTV_KEYRING="$dir/agentv.gpg" \
    "$ROOT/.agentv-os/bin/agentv-app-install" "$id" --index "$dir"
done

# The release is made the first time; after that, its two files are replaced.
if ! gh release view index -R "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
  gh release create index -R "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" --title "App index" \
    --notes "The signed index AgenTV boxes install the official apps from. CI replaces index.json and index.json.sig on every push to main."
fi
gh release upload index -R "$GITHUB_REPOSITORY" --clobber "$dir/index.json" "$dir/index.json.sig"
jq -r '.apps[] | "\(.id) \(.version) at \(.commit[0:12])"' "$dir/index.json"
